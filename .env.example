# Metricscope Time-Series Explorer — optional configuration.
# Every value below has a working default in src/config.py, so the app boots
# with no .env file at all.

# SQLite database file (relative to the project root).
METRICSCOPE_DB_PATH=./data/metricscope.db

# Session lifetime in days.
METRICSCOPE_SESSION_TTL_DAYS=7

# Upload guard in megabytes.
METRICSCOPE_MAX_UPLOAD_MB=25
